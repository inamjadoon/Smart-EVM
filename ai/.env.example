# OPTIONAL — you do NOT need ai/.env to run SmartEVM.
# The app reads its AI settings (GROQ_API_KEY, LLM_MODEL, ...) from backend/.env.
# Only create ai/.env (copy of this file) if you run the ai/ module on its own,
# e.g. `python -m ai.demo`. Values here never override backend/.env.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_TIMEOUT=30
