# ─────────────────────────────────────────────────────────────────────────────
#  SmartEVM backend settings  →  copy this file to  backend/.env  and fill it in
#  NEVER commit backend/.env (it is git-ignored). Ask the project owner for the
#  values marked [ASK OWNER] — they are shared privately, not on GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ──────────────────────────────  [ASK OWNER]
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require

# ── AI assistant (Groq) ─────────────────────────────────────  [ASK OWNER]
# Or create your own free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-20b
# Small fast model used to route questions to the AI agents
LLM_ROUTER_MODEL=qwen/qwen3.8-27b
# Tried in order when the main model hits its rate limit
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# ── Authentication ──────────────────────────────────────────  [GENERATE YOUR OWN]
# Long random secret that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=paste-a-long-random-string-here-at-least-32-characters
JWT_EXPIRE_MINUTES=480

# Bootstrap admin. The shared database ALREADY has the admin account, so
# teammates can leave ADMIN_PASSWORD empty. (Only used to create the first admin
# on a brand-new database.)
ADMIN_EMAIL=admin@smartevm.com
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# true = anyone can register (as Developer); false = only admins create accounts
ALLOW_SIGNUP=true

# ── Performance ─────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Production only ─────────────────────────────────────────
# Comma-separated frontend URL(s) allowed to call the API, e.g. https://app.example.com
# CORS_ORIGINS=
# Set to 1 on serverless hosting once the database is migrated, to shorten cold starts
# SKIP_STARTUP_MIGRATIONS=1
